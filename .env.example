# Salin file ini ke .env.local lalu isi nilainya.
# Semua variabel di bawah WAJIB ada di Vercel (Project → Settings → Environment Variables)
# untuk environment Production; tambahkan Preview juga kalau preview deployment
# perlu checkout/admin yang berfungsi.

# --- URL situs -----------------------------------------------------------
# TIDAK perlu diisi. URL publik (untuk metadata SEO, sitemap, robots.txt, dan
# JSON-LD) dihitung otomatis di data/site.ts: di Vercel memakai
# VERCEL_PROJECT_PRODUCTION_URL / VERCEL_URL yang disuntikkan host, di lokal
# jatuh ke http://localhost:3000. Begitu domain kustom dipasang di Vercel,
# nilainya ikut berubah sendiri.

# --- Supabase ------------------------------------------------------------
# Project Settings → API. URL + anon key dipakai untuk baca kategori/produk/
# pengaturan dari server (RLS membatasi ke baris aktif saja).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key: HANYA dipakai di API route server (tulis pesanan, pesan,
# dan seluruh panel admin). Jangan pernah dibuka ke browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Panel admin ---------------------------------------------------------
# Satu password untuk /admin/login. Nilai ini juga menjadi kunci tanda tangan
# cookie sesi, jadi menggantinya otomatis membuat semua sesi lama tidak valid.
# Pakai kombinasi panjang (min. 16 karakter).
ADMIN_PASSWORD=

# --- Cloudinary (upload gambar produk & QRIS) ----------------------------
# Dashboard → Product Environment Credentials. Upload memakai tanda tangan
# yang dihitung di server (/api/cloudinary/sign); API secret tidak pernah
# dikirim ke browser. Upload preset harus bertipe "Signed".
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
